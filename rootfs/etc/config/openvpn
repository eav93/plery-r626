
config openvpn 'custom_config'
        option config '/etc/openvpn/my-vpn.conf'

config openvpn 'sample_server'
        option port '1194'
        option proto 'udp'
        option dev 'tun'
        option server '10.8.0.0 255.255.255.0'
        option ifconfig_pool_persist '/tmp/ipp.txt'
        option persist_key '1'
        option persist_tun '1'
        option user 'nobody'
        option status '/tmp/openvpn-status.log'
        option verb '3'
        option ca '/etc/openvpn/server/ca.crt'
        option dh '/etc/openvpn/server/dh.pem'
        option cert '/etc/openvpn/server/server.crt'
        option key '/etc/openvpn/server/server.key'
        option enabled '0'
        option keepalive '10 120'

config openvpn 'sample_client'
        option client '1'
        option enabled '0'
        option dev 'tun'
        option proto 'udp'
        list remote 'my_server_1 1194'
        option resolv_retry 'infinite'
        option nobind '1'
        option persist_key '1'
        option persist_tun '1'
        option user 'nobody'
        option ca '/etc/openvpn/ca.crt'
        option cert '/etc/openvpn/clent/client.crt'
        option key '/etc/openvpn/clent/client.key'
        option verb '3'

