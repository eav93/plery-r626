config system
        option hostname 'PLERY'
        option log_size '16'
        option timezone 'UTC'
        option zonename '29'

config timeserver ntp
	list server	0.openwrt.pool.ntp.org
	list server	1.openwrt.pool.ntp.org
	list server	2.openwrt.pool.ntp.org
	list server	3.openwrt.pool.ntp.org
	option enabled 1
	option enable_server 0

config ac ac

config language language
	option language en
	option changed 1

config kickout kickout
	option disable 1
	option check_period 5
	option kickout_period 3600
	option signal_flag 70

config combine_wifi combine_wifi
	option enable 0

config heart_beat 'heart_beat'
	option hb_enable '1'

