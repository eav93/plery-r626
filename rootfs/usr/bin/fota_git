#!/bin/sh
#
# fota_git - OTA update checker for Plery R626
# Checks GitHub Releases for new firmware
#

REPO="eav93/plery-r626"
FOTA_DIR="/tmp/fota"
VERSION_FILE="/etc/defconfig/cf-plery/version"
API_URL="https://api.github.com/repos/$REPO/releases/latest"

mkdir -p "$FOTA_DIR"

# Resolve redirect chain via HEAD requests, return final URL
https_resolve() {
    local url="$1"
    local i=0
    while [ $i -lt 5 ]; do
        local host="${url#https://}"; host="${host%%/*}"
        local path="${url#https://$host}"; [ -z "$path" ] && path="/"
        local hdr=$(printf "HEAD %s HTTP/1.0\r\nHost: %s\r\nUser-Agent: fota_git/1.0\r\nConnection: close\r\n\r\n" \
            "$path" "$host" | openssl s_client -quiet -connect "${host}:443" 2>/dev/null)
        local status=$(echo "$hdr" | head -1 | grep -o "[0-9][0-9][0-9]" | head -1)
        case "$status" in
            301|302|303|307|308)
                url=$(echo "$hdr" | grep -i "^[Ll]ocation:" | head -1 | tr -d '\r\n' | sed 's/^[Ll]ocation: *//')
                i=$((i + 1))
                ;;
            *) echo "$url"; return 0 ;;
        esac
    done
    return 1
}

# Stream HTTPS response body to stdout (no tmpfile, sed strips headers)
https_stream() {
    local url="$1"
    local host="${url#https://}"; host="${host%%/*}"
    local path="${url#https://$host}"; [ -z "$path" ] && path="/"
    printf "GET %s HTTP/1.0\r\nHost: %s\r\nUser-Agent: fota_git/1.0\r\nConnection: close\r\n\r\n" \
        "$path" "$host" | \
        openssl s_client -quiet -connect "${host}:443" 2>/dev/null | \
        sed '1,/^\r\{0,1\}$/d'
}

# Fetch text URL (small responses, no redirect needed usually)
https_get() {
    local url="$1"
    local final_url=$(https_resolve "$url")
    [ -n "$final_url" ] && https_stream "$final_url" || https_stream "$url"
}

# Download binary URL to file (resolve redirects first, then stream)
https_download() {
    local url="$1"
    local out="$2"
    local final_url=$(https_resolve "$url")
    [ -z "$final_url" ] && final_url="$url"
    https_stream "$final_url" > "$out"
}

json_get() {
    echo "$1" | grep -o "\"$2\":\"[^\"]*\"" | head -1 | sed "s/\"$2\":\"//;s/\"$//"
}

json_get_num() {
    echo "$1" | grep -o "\"$2\":[0-9]*" | head -1 | sed "s/\"$2\"://"
}

get_current_version() {
    cat "$VERSION_FILE" 2>/dev/null || echo "unknown"
}

check_update() {
    local current_version=$(get_current_version)

    local release_json=$(https_get "$API_URL")
    if [ -z "$release_json" ]; then
        echo "5" > "$FOTA_DIR/fota_status"
        return 1
    fi

    local latest_tag=$(json_get "$release_json" "tag_name")
    local asset_url=$(json_get "$release_json" "browser_download_url")
    local asset_size=$(json_get_num "$release_json" "size")

    if [ -z "$latest_tag" ] || [ -z "$asset_url" ]; then
        echo "5" > "$FOTA_DIR/fota_status"
        return 1
    fi

    if [ "$current_version" = "$latest_tag" ]; then
        echo "$current_version" > "$FOTA_DIR/version"
        echo "5" > "$FOTA_DIR/fota_status"
        return 0
    fi

    # New version available - download
    echo "$latest_tag" > "$FOTA_DIR/version"
    echo "${asset_size:-0}" > "$FOTA_DIR/total_length"
    echo "3" > "$FOTA_DIR/fota_status"

    https_download "$asset_url" "$FOTA_DIR/firmware.bin"
    local actual_size=$(ls -l "$FOTA_DIR/firmware.bin" 2>/dev/null | awk '{print $5}')
    if [ -z "$actual_size" ] || [ "$actual_size" -lt 1000000 ]; then
        echo "4" > "$FOTA_DIR/fota_status"
        return 1
    fi

    md5sum "$FOTA_DIR/firmware.bin" | awk '{print $1}' > "$FOTA_DIR/md5sum"
    echo "$actual_size" > "$FOTA_DIR/total_length"
    echo "1" > "$FOTA_DIR/fota_status"
    return 0
}

case "$1" in
    -c|-d)
        # Background: webmgnt вызывает синхронно, форк чтобы не блокировать nginx
        check_update &
        ;;
    -w)
        # Foreground: для init.d демона
        check_update
        ;;
    *)
        echo "Usage: fota_git -c"
        exit 1
        ;;
esac
