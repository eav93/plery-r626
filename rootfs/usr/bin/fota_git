#!/bin/sh
#
# fota_git - OTA update checker for Plery R626
# Checks GitHub Releases for new firmware and matches the contract
# expected by the vendor `webmgnt` CGI:
#   - `fota_git -c` prints the latest version string (or a blank marker)
#   - `fota_git -d` downloads the cached/latest firmware into /tmp/fota
#   - `fota_git -w` is used by the auto-check daemon
#

REPO="eav93/plery-r626"
FOTA_DIR="/tmp/fota"
VERSION_FILE="/etc/defconfig/cf-plery/version"
API_URL="https://api.github.com/repos/$REPO/releases/latest"
DOWNLOAD_URL_FILE="$FOTA_DIR/download_url"
FIRMWARE_FILE="$FOTA_DIR/firmware.bin"
MD5_FILE="$FOTA_DIR/md5sum"
TOTAL_LENGTH_FILE="$FOTA_DIR/total_length"
VERSION_CACHE_FILE="$FOTA_DIR/version"

mkdir -p "$FOTA_DIR"

# Resolve redirect chain via HEAD requests, return final URL
https_resolve() {
    local url="$1"
    local i=0
    while [ $i -lt 5 ]; do
        local host="${url#https://}"; host="${host%%/*}"
        local path="${url#https://$host}"; [ -z "$path" ] && path="/"
        local hdr=$(printf "HEAD %s HTTP/1.0\r\nHost: %s\r\nUser-Agent: fota_git/1.0\r\nConnection: close\r\n\r\n" \
            "$path" "$host" | openssl s_client -quiet -connect "${host}:443" 2>/dev/null)
        local status=$(echo "$hdr" | head -1 | grep -o "[0-9][0-9][0-9]" | head -1)
        case "$status" in
            301|302|303|307|308)
                url=$(echo "$hdr" | grep -i "^[Ll]ocation:" | head -1 | tr -d '\r\n' | sed 's/^[Ll]ocation: *//')
                i=$((i + 1))
                ;;
            *) echo "$url"; return 0 ;;
        esac
    done
    return 1
}

# Stream HTTPS response body to stdout (no tmpfile, sed strips headers)
https_stream() {
    local url="$1"
    local host="${url#https://}"; host="${host%%/*}"
    local path="${url#https://$host}"; [ -z "$path" ] && path="/"
    printf "GET %s HTTP/1.0\r\nHost: %s\r\nUser-Agent: fota_git/1.0\r\nConnection: close\r\n\r\n" \
        "$path" "$host" | \
        openssl s_client -quiet -connect "${host}:443" 2>/dev/null | \
        sed '1,/^\r\{0,1\}$/d'
}

# Fetch text URL (small responses, no redirect needed usually)
https_get() {
    local url="$1"
    local final_url=$(https_resolve "$url")
    [ -n "$final_url" ] && https_stream "$final_url" || https_stream "$url"
}

# Download binary URL to file (resolve redirects first, then stream)
https_download() {
    local url="$1"
    local out="$2"
    local final_url=$(https_resolve "$url")
    [ -z "$final_url" ] && final_url="$url"
    https_stream "$final_url" > "$out"
}

json_get() {
    printf '%s' "$1" | tr -d '\r\n' | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p"
}

json_get_num() {
    printf '%s' "$1" | tr -d '\r\n' | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\\([0-9][0-9]*\\).*/\\1/p"
}

get_current_version() {
    cat "$VERSION_FILE" 2>/dev/null || echo "unknown"
}

model_prefix() {
    local current_version="$1"
    echo "${current_version%-*}"
}

clear_cached_files() {
    rm -f "$DOWNLOAD_URL_FILE" "$FIRMWARE_FILE" "$MD5_FILE" "$TOTAL_LENGTH_FILE"
}

cache_release() {
    local tag="$1"
    local asset_url="$2"
    local asset_size="$3"
    local old_tag

    old_tag=$(cat "$VERSION_CACHE_FILE" 2>/dev/null)
    if [ "$old_tag" != "$tag" ]; then
        rm -f "$FIRMWARE_FILE" "$MD5_FILE"
    fi

    printf '%s\n' "$tag" > "$VERSION_CACHE_FILE"
    printf '%s\n' "${asset_size:-0}" > "$TOTAL_LENGTH_FILE"
    printf '%s\n' "$asset_url" > "$DOWNLOAD_URL_FILE"
}

print_blank_result() {
    # webmgnt copies stdout with strcpy(); ensure the command always produces
    # a non-empty stream so CGI does not choke on a NULL result.
    printf ' \n'
}

fetch_release_info() {
    RELEASE_JSON=$(https_get "$API_URL")
    [ -n "$RELEASE_JSON" ] || return 1

    RELEASE_TAG=$(json_get "$RELEASE_JSON" "tag_name")
    RELEASE_URL=$(json_get "$RELEASE_JSON" "browser_download_url")
    RELEASE_SIZE=$(json_get_num "$RELEASE_JSON" "size")

    [ -n "$RELEASE_TAG" ] || return 1
    [ -n "$RELEASE_URL" ] || return 1
    return 0
}

release_matches_device() {
    local current_version="$1"
    local prefix

    prefix=$(model_prefix "$current_version")
    case "$RELEASE_TAG" in
        "$prefix"|"$prefix"-*)
            return 0
            ;;
    esac
    return 1
}

check_only() {
    local current_version

    current_version=$(get_current_version)

    if ! fetch_release_info || ! release_matches_device "$current_version"; then
        printf '%s\n' "$current_version" > "$VERSION_CACHE_FILE"
        clear_cached_files
        printf '%s\n' "$current_version" > "$VERSION_CACHE_FILE"
        print_blank_result
        return 1
    fi

    if [ "$RELEASE_TAG" = "$current_version" ]; then
        printf '%s\n' "$current_version" > "$VERSION_CACHE_FILE"
        clear_cached_files
        printf '%s\n' "$current_version" > "$VERSION_CACHE_FILE"
        print_blank_result
        return 0
    fi

    cache_release "$RELEASE_TAG" "$RELEASE_URL" "$RELEASE_SIZE"
    printf '%s\n' "$RELEASE_TAG"
    return 0
}

download_release() {
    local current_version
    local cached_tag
    local cached_url
    local actual_size

    current_version=$(get_current_version)
    cached_tag=$(cat "$VERSION_CACHE_FILE" 2>/dev/null)
    cached_url=$(cat "$DOWNLOAD_URL_FILE" 2>/dev/null)

    if [ -n "$cached_tag" ] && [ -n "$cached_url" ] && [ "$cached_tag" != "$current_version" ]; then
        RELEASE_TAG="$cached_tag"
        RELEASE_URL="$cached_url"
        RELEASE_SIZE=$(cat "$TOTAL_LENGTH_FILE" 2>/dev/null)
    else
        if ! fetch_release_info || ! release_matches_device "$current_version"; then
            printf '%s\n' "ERROR" > "$TOTAL_LENGTH_FILE"
            return 1
        fi

        if [ "$RELEASE_TAG" = "$current_version" ]; then
            printf '%s\n' "$current_version" > "$VERSION_CACHE_FILE"
            clear_cached_files
            printf '%s\n' "$current_version" > "$VERSION_CACHE_FILE"
            return 0
        fi

        cache_release "$RELEASE_TAG" "$RELEASE_URL" "$RELEASE_SIZE"
    fi

    rm -f "$MD5_FILE"
    : > "$FIRMWARE_FILE"

    https_download "$RELEASE_URL" "$FIRMWARE_FILE"
    actual_size=$(ls -l "$FIRMWARE_FILE" 2>/dev/null | awk '{print $5}')
    if [ -z "$actual_size" ] || [ "$actual_size" -lt 1000000 ]; then
        printf '%s\n' "ERROR" > "$TOTAL_LENGTH_FILE"
        rm -f "$MD5_FILE"
        return 1
    fi

    md5sum "$FIRMWARE_FILE" | awk '{print $1}' > "$MD5_FILE"
    printf '%s\n' "$actual_size" > "$TOTAL_LENGTH_FILE"
    return 0
}

auto_check() {
    local current_version

    current_version=$(get_current_version)

    if ! fetch_release_info || ! release_matches_device "$current_version"; then
        printf '%s\n' "$current_version" > "$VERSION_CACHE_FILE"
        return 1
    fi

    if [ "$RELEASE_TAG" = "$current_version" ]; then
        printf '%s\n' "$current_version" > "$VERSION_CACHE_FILE"
        clear_cached_files
        printf '%s\n' "$current_version" > "$VERSION_CACHE_FILE"
        return 0
    fi

    cache_release "$RELEASE_TAG" "$RELEASE_URL" "$RELEASE_SIZE"
    if [ -s "$FIRMWARE_FILE" ] && [ -s "$MD5_FILE" ]; then
        return 0
    fi

    download_release
}

case "$1" in
    -c)
        check_only
        ;;
    -d)
        download_release >/dev/null 2>&1
        ;;
    -w)
        auto_check
        ;;
    *)
        echo "Usage: fota_git -c"
        exit 1
        ;;
esac
