#!/bin/sh
#
# fota_git - OTA update checker for Plery R626
# Checks GitHub Releases for new firmware
#

REPO="eav93/plery-r626"
FOTA_DIR="/tmp/fota"
VERSION_FILE="/etc/defconfig/cf-plery/version"
API_URL="https://api.github.com/repos/$REPO/releases/latest"

mkdir -p "$FOTA_DIR"

https_get() {
    local url="$1"
    local host="${url#https://}"
    host="${host%%/*}"
    local path="${url#https://$host}"
    printf "GET %s HTTP/1.0\r\nHost: %s\r\nUser-Agent: fota_git/1.0\r\nConnection: close\r\n\r\n" \
        "$path" "$host" | \
        openssl s_client -quiet -connect "${host}:443" 2>/dev/null | \
        sed '1,/^\r\{0,1\}$/d'
}

fetch_url() {
    uclient-fetch -q -O - "$1" 2>/dev/null || \
    wget -q -O - "$1" 2>/dev/null || \
    https_get "$1"
}

get_current_version() {
    cat "$VERSION_FILE" 2>/dev/null || echo "unknown"
}

check_update() {
    local current_version=$(get_current_version)

    # Fetch latest release info
    local release_json=$(fetch_url "$API_URL")
    if [ -z "$release_json" ]; then
        echo "5" > "$FOTA_DIR/fota_status"
        return 1
    fi

    # Parse release tag and asset URL
    local latest_tag=$(echo "$release_json" | jsonfilter -e '@.tag_name' 2>/dev/null)
    local asset_url=$(echo "$release_json" | jsonfilter -e '@.assets[0].browser_download_url' 2>/dev/null)
    local asset_size=$(echo "$release_json" | jsonfilter -e '@.assets[0].size' 2>/dev/null)

    if [ -z "$latest_tag" ] || [ -z "$asset_url" ]; then
        echo "5" > "$FOTA_DIR/fota_status"
        return 1
    fi

    # Compare versions
    if [ "$current_version" = "$latest_tag" ]; then
        echo "$current_version" > "$FOTA_DIR/version"
        echo "5" > "$FOTA_DIR/fota_status"
        return 0
    fi

    # New version available - download
    echo "$latest_tag" > "$FOTA_DIR/version"
    echo "$asset_size" > "$FOTA_DIR/total_length"
    echo "3" > "$FOTA_DIR/fota_status"

    fetch_url "$asset_url" > "$FOTA_DIR/firmware.bin"
    if [ $? -ne 0 ] || [ ! -f "$FOTA_DIR/firmware.bin" ]; then
        echo "4" > "$FOTA_DIR/fota_status"
        return 1
    fi

    # Calculate MD5
    md5sum "$FOTA_DIR/firmware.bin" | awk '{print $1}' > "$FOTA_DIR/md5sum"
    local actual_size=$(ls -l "$FOTA_DIR/firmware.bin" | awk '{print $5}')
    echo "$actual_size" > "$FOTA_DIR/total_length"

    # Downloaded OK
    echo "1" > "$FOTA_DIR/fota_status"
    return 0
}

case "$1" in
    -c|-d)
        # Run in background so webmgnt (get_cmd_result) returns immediately
        # without blocking nginx → avoids 502 timeout.
        # Status is written to $FOTA_DIR/fota_status and read by next poll.
        check_update &
        ;;
    -w)
        # Foreground mode for init.d daemon (waits for completion)
        check_update
        ;;
    *)
        echo "Usage: fota_git -c"
        exit 1
        ;;
esac
